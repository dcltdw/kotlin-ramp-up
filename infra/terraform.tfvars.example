# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored
# (.gitignore has *.tfvars with a !*.tfvars.example exception), so the real file
# never gets committed.

# Required. Where AWS Budgets sends the $25 alerts. Use an address you actually
# read — an unmonitored budget alert is the same as no budget alert.
budget_alert_email = "you@example.com"

# Which credentials to use. Leave unset to follow AWS_PROFILE and then
# `default`. Set it if `default` is not the account you want.
#
# Authenticate an IAM Identity Center profile with `aws sso login`, NOT
# `aws login` — the latter is a different mechanism (console credentials for
# local development) and will not work for an SSO profile:
#
#   aws sso login --profile AdministratorAccess-675789572470
#
# aws_profile = "AdministratorAccess-675789572470"

# Refuse to apply against any other account. Strongly worth setting when the
# target account is shared with another project, because the failure mode of a
# misresolved profile is a duplicate stack and a surprising bill.
# expected_account_id = "675789572470"

# Optional overrides; the defaults match the plan.
# aws_region        = "us-east-1"
# instance_type     = "t4g.small"
# budget_limit_usd  = "25"

# Narrow public exposure to just your own address if you prefer. Find it with
# `curl -s https://checkip.amazonaws.com`.
# app_ingress_cidrs = ["203.0.113.4/32"]
